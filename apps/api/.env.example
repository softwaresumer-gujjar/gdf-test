# Copy this to .env and fill in real values
# Stripe keys: https://dashboard.stripe.com/apikeys
# Supabase keys: Supabase Dashboard → Project Settings → API

PORT=4000
FRONTEND_URL=http://localhost:3000

STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_CURRENCY=pkr
# Run: stripe listen --forward-to localhost:4000/webhooks/stripe
# The CLI will print your local webhook secret
STRIPE_WEBHOOK_SECRET=whsec_YOUR_LOCAL_CLI_SECRET

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
